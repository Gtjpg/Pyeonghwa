# ---------- Database ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pyeonghwa
DB_USER=postgres
DB_PASSWORD=change-me

# ---------- Login tokens ----------
# Required. At least 32 random characters, for example the output of:
#   openssl rand -hex 32
# The server will not start without it. Never share it or commit it.
JWT_SECRET=

# ---------- Server ----------
PORT=3000
# The address people open the website at. Use https:// when it is hosted online.
CLIENT_ORIGIN=http://localhost:5173
# Set to production when the site is live. The server then refuses to start
# with a short JWT_SECRET.
# NODE_ENV=production
# Behind a reverse proxy (nginx, Render, Railway...)? Set the number of
# proxies (usually 1) so rate limits see each visitor's real address.
# TRUST_PROXY=1

# ---------- Private photo storage ----------
# Where photos are kept. Must NOT be inside backend/public. Photos are only
# served through the login-protected /conversations/:id/images/:name address.
# Default: backend/storage/uploads
# UPLOAD_DIR=/var/lib/pyeonghwa/uploads

# ---------- Calls across different networks (TURN relay) ----------
# See TURN_SETUP.md. Leave these empty to use direct calls only.
TURN_URLS=
TURN_SECRET=
# Hosted TURN service with one fixed login instead of TURN_SECRET:
# TURN_USERNAME=
# TURN_CREDENTIAL=
