# Where the backend is. Change this when the site is hosted online,
# for example https://api.example.com
VITE_API_URL=http://localhost:3000

# Test switch for calls: true = every call must go through the TURN relay.
# If calls still work with this on, your relay is set up correctly.
# Turn it off (or delete the line) for normal use.
# VITE_FORCE_RELAY=true
