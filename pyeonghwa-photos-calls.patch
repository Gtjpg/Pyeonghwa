@@ -0,0 +1,56 @@
+# coturn settings for Pyeonghwa calls.
+# Copy to /etc/turnserver.conf on a server with a public IP address, change the
+# three settings marked CHANGE, then restart coturn (see TURN_SETUP.md).
+
+# ---------- Ports ----------
+listening-port=3478
+# For the secure turns: address you also need a certificate (see the end).
+tls-listening-port=5349
+
+# ---------- Your server ----------
+# CHANGE the next two lines to your domain name.
+realm=turn.example.com
+server-name=turn.example.com
+# Servers that sit behind NAT (AWS, Google Cloud, Oracle and similar) must
+# state their public address. Use "PUBLIC_IP" or "PUBLIC_IP/PRIVATE_IP".
+# external-ip=203.0.113.10
+
+# ---------- Login ----------
+# People get a temporary password from your backend (TURN_SECRET in backend/.env
+# must be the same value as below). No accounts or passwords to manage.
+use-auth-secret
+# CHANGE this to a long random secret (for example: openssl rand -hex 32).
+static-auth-secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
+
+# ---------- Relay ports ----------
+# Open this UDP range in your firewall, together with 3478 (UDP and TCP).
+min-port=49152
+max-port=65535
+
+# ---------- Safety ----------
+fingerprint
+no-multicast-peers
+no-cli
+# Stops anyone from using your relay to reach private or internal addresses.
+denied-peer-ip=0.0.0.0-0.255.255.255
+denied-peer-ip=10.0.0.0-10.255.255.255
+denied-peer-ip=100.64.0.0-100.127.255.255
+denied-peer-ip=127.0.0.0-127.255.255.255
+denied-peer-ip=169.254.0.0-169.254.255.255
+denied-peer-ip=172.16.0.0-172.31.255.255
+denied-peer-ip=192.0.0.0-192.0.0.255
+denied-peer-ip=192.168.0.0-192.168.255.255
+denied-peer-ip=198.18.0.0-198.19.255.255
+denied-peer-ip=::1
+denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
+denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
+
+# ---------- Limits ----------
+# Nothing is limited here: no cap on calls, time or bandwidth. The only limits
+# are your server's own internet speed and your hosting plan's data allowance.
+
+# ---------- Secure turns: (recommended, works through stricter firewalls) ----------
+# Get a free certificate with:  sudo certbot certonly --standalone -d turn.example.com
+# then remove the "#" from the next two lines.
+# cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
+# pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem
