--- /dev/null
+++ b/backend/test/uploads.test.mjs
@@ -0,0 +1,216 @@
+// Unit tests for private photo storage (no database or server needed).
+import { test, describe, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const backendDir = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
+const root = fs.mkdtempSync(path.join(os.tmpdir(), "pw-unit-uploads-"));
+process.env.UPLOAD_DIR = path.join(root, "storage");
+process.env.LEGACY_UPLOAD_DIR = path.join(root, "legacy");
+
+const uploads = (await import("../uploads.js")).default;
+
+// ---- tiny valid-looking files, built by hand ----
+const pad = (head, size = 64) => Buffer.concat([head, Buffer.alloc(Math.max(0, size - head.length))]);
+const JPEG = pad(Buffer.from([0xff, 0xd8, 0xff, 0xe0]));
+const PNG = pad(Buffer.concat([
+  Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 13]),
+  Buffer.from("IHDR"),
+]));
+const WEBP = pad(Buffer.concat([Buffer.from("RIFF"), Buffer.alloc(4), Buffer.from("WEBPVP8 ")]));
+const NAME = "a".repeat(32) + ".jpg";
+
+after(() => fs.rmSync(root, { recursive: true, force: true }));
+
+describe("detectImageType: judged by the file's own bytes", () => {
+  test("accepts real JPEG, PNG and WebP headers", () => {
+    assert.equal(uploads.detectImageType(JPEG), "jpg");
+    assert.equal(uploads.detectImageType(PNG), "png");
+    assert.equal(uploads.detectImageType(WEBP), "webp");
+  });
+
+  test("rejects other formats and disguised files", () => {
+    const rejected = {
+      gif: pad(Buffer.from("GIF89a")),
+      svg: pad(Buffer.from('<svg xmlns="http://www.w3.org/2000/svg"><script>alert(1)</script></svg>')),
+      html: pad(Buffer.from("<!doctype html><script>alert(1)</script>")),
+      php: pad(Buffer.from("<?php system($_GET['x']); ?>")),
+      exe: pad(Buffer.from("MZ")),
+      pdf: pad(Buffer.from("%PDF-1.7")),
+      text: Buffer.from("just some text pretending to be a photo, long enough to pass the size check"),
+      "PNG signature but no IHDR": pad(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])),
+      "RIFF but not WebP": pad(Buffer.concat([Buffer.from("RIFF"), Buffer.alloc(4), Buffer.from("WAVEfmt ")])),
+      "JPEG start with no marker": pad(Buffer.from([0xff, 0xd8, 0xff, 0x00])),
+      empty: Buffer.alloc(0),
+      tiny: Buffer.from([0xff, 0xd8, 0xff, 0xe0]),
+    };
+
+    for (const [label, buffer] of Object.entries(rejected)) {
+      assert.equal(uploads.detectImageType(buffer), null, label);
+    }
+  });
+
+  test("rejects values that are not buffers", () => {
+    for (const value of [null, undefined, "string", 5, {}, [], new Uint8Array(100)]) {
+      assert.equal(uploads.detectImageType(value), null);
+    }
+  });
+});
+
+describe("addresses and paths", () => {
+  test("parseImageUrl only accepts the exact private address shape", () => {
+    assert.deepEqual(uploads.parseImageUrl(`/conversations/12/images/${NAME}`), {
+      conversationId: 12,
+      name: NAME,
+    });
+
+    const bad = [
+      `/uploads/${NAME}`, // the old public address
+      `/uploads/tmp/${NAME}`,
+      `/conversations/0/images/${NAME}`,
+      `/conversations/012/images/${NAME}`,
+      `/conversations/-1/images/${NAME}`,
+      `/conversations/1e3/images/${NAME}`,
+      `/conversations/99999999999/images/${NAME}`,
+      `/conversations/1/images/../${NAME}`,
+      `/conversations/1/images/${NAME}/`,
+      `/conversations/1/images/${NAME}?x=1`,
+      `/conversations/1/images/${NAME}.exe`,
+      `/conversations/1/images/${"A".repeat(32)}.jpg`,
+      `/conversations/1/images/${"a".repeat(31)}.jpg`,
+      `/conversations/1/images/${"a".repeat(32)}.gif`,
+      `http://evil.example/conversations/1/images/${NAME}`,
+      `//evil.example/conversations/1/images/${NAME}`,
+      "", null, undefined, 7, {}, [],
+    ];
+
+    for (const url of bad) assert.equal(uploads.parseImageUrl(url), null, String(url));
+  });
+
+  test("imagePath builds paths inside storage and refuses anything odd", () => {
+    const file = uploads.imagePath(5, NAME);
+    assert.equal(file, path.join(uploads.UPLOAD_ROOT, "5", NAME));
+    assert.ok(file.startsWith(uploads.UPLOAD_ROOT + path.sep));
+    assert.equal(uploads.imagePath(5, NAME, true), path.join(uploads.TEMP_ROOT, "5", NAME));
+
+    const badNames = ["../x.jpg", "..\\x.jpg", `${NAME}\0`, "a/b.jpg", "x.jpg", "", null, `../${NAME}`, `${NAME}/..`];
+    for (const name of badNames) assert.throws(() => uploads.imagePath(5, name), /Invalid/, String(name));
+
+    for (const id of [0, -1, 1.5, NaN, "5", null, "../..", 2 ** 40]) {
+      assert.throws(() => uploads.imagePath(id, NAME), /Invalid/, String(id));
+    }
+  });
+});
+
+describe("saving, finding, moving and deleting", () => {
+  before(() => uploads.ensureUploadDirs());
+
+  test("saveImage writes a private, random-named file and never overwrites", async () => {
+    const name = await uploads.saveImage(7, JPEG, "jpg");
+    assert.match(name, /^[a-f0-9]{32}\.jpg$/);
+
+    const file = uploads.imagePath(7, name);
+    assert.ok(fs.readFileSync(file).equals(JPEG));
+    if (process.platform !== "win32") assert.equal(fs.statSync(file).mode & 0o077, 0, "not readable by others");
+
+    const other = await uploads.saveImage(7, JPEG, "jpg");
+    assert.notEqual(other, name);
+  });
+
+  test("findImage finds saved and temporary photos, only inside their own conversation", async () => {
+    const saved = await uploads.saveImage(8, PNG, "png");
+    const temp = await uploads.saveImage(8, WEBP, "webp", true);
+
+    assert.equal((await uploads.findImage(8, saved)).temp, false);
+    assert.equal((await uploads.findImage(8, temp)).temp, true);
+    assert.equal(await uploads.findImage(9, saved), null, "other conversation");
+    assert.equal(await uploads.findImage(8, "f".repeat(32) + ".jpg"), null, "unknown file");
+    assert.equal(await uploads.findImage(8, "../../x"), null, "bad name");
+    assert.equal(await uploads.findImage("8", saved), null, "id must be a number");
+  });
+
+  test("findImage refuses a symbolic link that points outside storage", async (t) => {
+    const secret = path.join(root, "outside-secret.jpg");
+    fs.writeFileSync(secret, JPEG);
+
+    const dir = path.join(uploads.UPLOAD_ROOT, "10");
+    fs.mkdirSync(dir, { recursive: true });
+    const link = path.join(dir, NAME);
+
+    try {
+      fs.symlinkSync(secret, link);
+    } catch {
+      return t.skip("cannot create symbolic links here");
+    }
+
+    assert.equal(await uploads.findImage(10, NAME), null);
+  });
+
+  test("relocateImage moves a photo between saved and temporary storage", async () => {
+    const name = await uploads.saveImage(11, JPEG, "jpg", true);
+
+    assert.equal(await uploads.relocateImage(11, name, false), true);
+    assert.equal((await uploads.findImage(11, name)).temp, false);
+
+    assert.equal(await uploads.relocateImage(11, name, true), true);
+    assert.equal((await uploads.findImage(11, name)).temp, true);
+
+    assert.equal(await uploads.relocateImage(11, name, true), true, "already there");
+    assert.equal(await uploads.relocateImage(11, "e".repeat(32) + ".jpg", true), false, "missing");
+  });
+
+  test("deleteConversationImages removes everything for those conversations only", async () => {
+    const a = await uploads.saveImage(20, JPEG, "jpg");
+    const b = await uploads.saveImage(20, JPEG, "jpg", true);
+    const keep = await uploads.saveImage(21, JPEG, "jpg");
+
+    await uploads.deleteConversationImages([20, "../..", -5, null, 20.5]);
+
+    assert.equal(await uploads.findImage(20, a), null);
+    assert.equal(await uploads.findImage(20, b), null);
+    assert.ok(await uploads.findImage(21, keep), "other conversation untouched");
+    assert.ok(fs.existsSync(uploads.UPLOAD_ROOT), "storage root untouched");
+  });
+
+  test("cleanTempUploads deletes old temporary photos and keeps fresh ones", async () => {
+    const old = await uploads.saveImage(30, JPEG, "jpg", true);
+    const fresh = await uploads.saveImage(30, JPEG, "jpg", true);
+    const oldFile = uploads.imagePath(30, old, true);
+    const twoHoursAgo = new Date(Date.now() - 2 * 60 * 60 * 1000);
+    fs.utimesSync(oldFile, twoHoursAgo, twoHoursAgo);
+
+    await uploads.cleanTempUploads();
+
+    assert.equal(await uploads.findImage(30, old), null);
+    assert.ok(await uploads.findImage(30, fresh));
+  });
+});
+
+describe("configuration", () => {
+  test("refuses to store photos inside the public folder", () => {
+    const result = spawnSync(process.execPath, ["-e", 'require("./uploads")'], {
+      cwd: backendDir,
+      env: { ...process.env, UPLOAD_DIR: path.join(backendDir, "public", "photos") },
+      encoding: "utf8",
+    });
+
+    assert.notEqual(result.status, 0);
+    assert.match(result.stderr, /must not be inside the public folder/);
+  });
+
+  test("the default storage folder is not inside the public folder", () => {
+    const result = spawnSync(process.execPath, ["-e", 'const u=require("./uploads");console.log(u.UPLOAD_ROOT)'], {
+      cwd: backendDir,
+      env: { ...process.env, UPLOAD_DIR: "" },
+      encoding: "utf8",
+    });
+
+    assert.equal(result.status, 0, result.stderr);
+    const publicDir = path.join(backendDir, "public");
+    assert.ok(!result.stdout.trim().startsWith(publicDir + path.sep));
+  });
+});
diff --git a/backend/uploads.js b/backend/uploads.js
new file mode 100644
index 0000000..89e7cd0
--- /dev/null
+++ b/backend/uploads.js
@@ -0,0 +1,386 @@
+/**
+ * Private photo storage.
+ *
+ * Photos are NOT served from a public folder. They live in UPLOAD_DIR (outside
+ * the web-served `public` folder) and are only readable through
+ * GET /conversations/:id/images/:name, which checks the login token and that
+ * the person belongs to that conversation.
+ *
+ * Layout:  <UPLOAD_DIR>/<conversationId>/<name>        chats that save history
+ *          <UPLOAD_DIR>/tmp/<conversationId>/<name>    chats that don't (deleted after 1 hour)
+ *
+ * The conversation id is part of the path, so a file can only ever be read
+ * through the conversation it was uploaded to.
+ */
+const fs = require("fs");
+const path = require("path");
+const crypto = require("crypto");
+const pool = require("./db");
+
+const MAX_IMAGE_BYTES = 5 * 1024 * 1024;
+const TEMP_MAX_AGE_MS = 60 * 60 * 1000;
+
+const PUBLIC_DIR = path.resolve(__dirname, "public");
+const UPLOAD_ROOT = path.resolve(
+  process.env.UPLOAD_DIR || path.join(__dirname, "storage", "uploads"),
+);
+const TEMP_ROOT = path.join(UPLOAD_ROOT, "tmp");
+
+// The folder the old, public version used. Only read once, to migrate.
+const LEGACY_DIR = path.resolve(
+  process.env.LEGACY_UPLOAD_DIR || path.join(__dirname, "uploads"),
+);
+
+if (UPLOAD_ROOT === PUBLIC_DIR || UPLOAD_ROOT.startsWith(PUBLIC_DIR + path.sep)) {
+  throw new Error("UPLOAD_DIR must not be inside the public folder");
+}
+
+const IMAGE_NAME = /^[a-f0-9]{32}\.(jpg|png|webp)$/;
+const IMAGE_URL =
+  /^\/conversations\/([1-9]\d{0,9})\/images\/([a-f0-9]{32}\.(?:jpg|png|webp))$/;
+
+const MIME_TYPES = {
+  jpg: "image/jpeg",
+  png: "image/png",
+  webp: "image/webp",
+};
+
+/* ---------- Validation ---------- */
+
+function isValidConversationId(id) {
+  return Number.isInteger(id) && id > 0 && id <= 2147483647;
+}
+
+function isValidImageName(name) {
+  return typeof name === "string" && IMAGE_NAME.test(name);
+}
+
+function mimeTypeFor(name) {
+  return MIME_TYPES[name.slice(name.lastIndexOf(".") + 1)];
+}
+
+// Looks at the file's own bytes. The file name and the type the browser
+// reports are never trusted.
+function detectImageType(buffer) {
+  if (!Buffer.isBuffer(buffer) || buffer.length < 32) return null;
+
+  // JPEG: starts with FF D8 FF and a real marker byte
+  if (
+    buffer[0] === 0xff &&
+    buffer[1] === 0xd8 &&
+    buffer[2] === 0xff &&
+    buffer[3] >= 0xc0 &&
+    buffer[3] !== 0xff
+  ) {
+    return "jpg";
+  }
+
+  // PNG: signature, then the IHDR header chunk
+  if (
+    buffer.subarray(0, 8).equals(
+      Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+    ) &&
+    buffer.subarray(12, 16).toString("ascii") === "IHDR"
+  ) {
+    return "png";
+  }
+
+  // WebP: RIFF container holding a VP8 / VP8L / VP8X chunk
+  if (
+    buffer.subarray(0, 4).toString("ascii") === "RIFF" &&
+    buffer.subarray(8, 12).toString("ascii") === "WEBP" &&
+    ["VP8 ", "VP8L", "VP8X"].includes(buffer.subarray(12, 16).toString("ascii"))
+  ) {
+    return "webp";
+  }
+
+  return null;
+}
+
+/* ---------- Addresses and paths ---------- */
+
+function imageUrl(conversationId, name) {
+  return `/conversations/${conversationId}/images/${name}`;
+}
+
+// "/conversations/12/images/<name>" -> { conversationId: 12, name }
+function parseImageUrl(url) {
+  const match = typeof url === "string" ? IMAGE_URL.exec(url) : null;
+
+  return match ? { conversationId: Number(match[1]), name: match[2] } : null;
+}
+
+function conversationDir(conversationId, temp) {
+  return path.join(temp ? TEMP_ROOT : UPLOAD_ROOT, String(conversationId));
+}
+
+// Builds a file path only from a validated id and name, and double-checks
+// that it stays inside the storage folder.
+function imagePath(conversationId, name, temp = false) {
+  if (!isValidConversationId(conversationId) || !isValidImageName(name)) {
+    throw new Error("Invalid image reference");
+  }
+
+  const file = path.join(conversationDir(conversationId, temp), name);
+
+  if (!file.startsWith(UPLOAD_ROOT + path.sep)) {
+    throw new Error("Invalid image path");
+  }
+
+  return file;
+}
+
+async function ensureUploadDirs() {
+  await fs.promises.mkdir(TEMP_ROOT, { recursive: true, mode: 0o700 });
+}
+
+/* ---------- Saving, finding, moving, deleting ---------- */
+
+async function saveImage(conversationId, buffer, type, temp = false) {
+  const name = `${crypto.randomBytes(16).toString("hex")}.${type}`;
+  const file = imagePath(conversationId, name, temp);
+
+  await fs.promises.mkdir(path.dirname(file), { recursive: true, mode: 0o700 });
+  // "wx": never overwrite an existing file
+  await fs.promises.writeFile(file, buffer, { flag: "wx", mode: 0o600 });
+
+  return name;
+}
+
+// Returns { file, temp } for a photo that exists, otherwise null. Also refuses
+// anything that isn't a plain file inside the storage folder (for example a
+// symbolic link pointing somewhere else).
+async function findImage(conversationId, name) {
+  if (!isValidConversationId(conversationId) || !isValidImageName(name)) {
+    return null;
+  }
+
+  let rootReal;
+
+  try {
+    rootReal = await fs.promises.realpath(UPLOAD_ROOT);
+  } catch {
+    return null;
+  }
+
+  for (const temp of [false, true]) {
+    try {
+      const file = imagePath(conversationId, name, temp);
+      const real = await fs.promises.realpath(file);
+      const stats = await fs.promises.stat(real);
+
+      if (stats.isFile() && real.startsWith(rootReal + path.sep)) {
+        return { file: real, temp };
+      }
+    } catch {
+      // not in this folder
+    }
+  }
+
+  return null;
+}
+
+// Keeps a photo in the folder that matches the chat's history setting.
+async function relocateImage(conversationId, name, toTemp) {
+  const found = await findImage(conversationId, name);
+
+  if (!found) return false;
+  if (found.temp === toTemp) return true;
+
+  const target = imagePath(conversationId, name, toTemp);
+
+  await fs.promises.mkdir(path.dirname(target), { recursive: true, mode: 0o700 });
+
+  try {
+    await fs.promises.rename(found.file, target);
+  } catch (error) {
+    if (error.code !== "EXDEV") throw error;
+
+    // Different disks: copy, then remove the original.
+    await fs.promises.copyFile(found.file, target);
+    await fs.promises.unlink(found.file);
+  }
+
+  return true;
+}
+
+// Removes every saved and temporary photo of these conversations.
+async function deleteConversationImages(conversationIds) {
+  for (const id of conversationIds) {
+    if (!isValidConversationId(id)) continue;
+
+    for (const temp of [false, true]) {
+      await fs.promises
+        .rm(conversationDir(id, temp), { recursive: true, force: true })
+        .catch((error) => console.error("Photo delete error:", error.code));
+    }
+  }
+}
+
+/* ---------- Clean-up jobs ---------- */
+
+async function numericDirs(root) {
+  try {
+    const entries = await fs.promises.readdir(root, { withFileTypes: true });
+
+    return entries
+      .filter((entry) => entry.isDirectory() && /^[1-9]\d{0,9}$/.test(entry.name))
+      .map((entry) => entry.name);
+  } catch {
+    return [];
+  }
+}
+
+// Photos from chats that don't save history are removed after an hour.
+async function cleanTempUploads() {
+  const cutoff = Date.now() - TEMP_MAX_AGE_MS;
+
+  for (const dirName of await numericDirs(TEMP_ROOT)) {
+    const dir = path.join(TEMP_ROOT, dirName);
+
+    try {
+      for (const fileName of await fs.promises.readdir(dir)) {
+        const file = path.join(dir, fileName);
+        const stats = await fs.promises.stat(file);
+
+        if (stats.isFile() && stats.mtimeMs < cutoff) {
+          await fs.promises.unlink(file);
+        }
+      }
+
+      await fs.promises.rmdir(dir).catch(() => {}); // only if empty
+    } catch (error) {
+      console.error("Temp photo clean-up error:", error.code);
+    }
+  }
+}
+
+// Photos that were uploaded but never attached to a message (for example a
+// failed send) are removed after an hour.
+async function cleanOrphanUploads() {
+  const cutoff = Date.now() - TEMP_MAX_AGE_MS;
+
+  for (const dirName of await numericDirs(UPLOAD_ROOT)) {
+    const dir = path.join(UPLOAD_ROOT, dirName);
+
+    try {
+      for (const fileName of await fs.promises.readdir(dir)) {
+        if (!isValidImageName(fileName)) continue;
+
+        const file = path.join(dir, fileName);
+        const stats = await fs.promises.stat(file);
+
+        if (!stats.isFile() || stats.mtimeMs > cutoff) continue;
+
+        const used = await pool.query(
+          `SELECT 1 FROM messages WHERE image_url = $1 LIMIT 1`,
+          [imageUrl(Number(dirName), fileName)],
+        );
+
+        if (used.rows.length === 0) await fs.promises.unlink(file);
+      }
+    } catch (error) {
+      console.error("Orphan photo clean-up error:", error.code || error.message);
+    }
+  }
+}
+
+/* ---------- One-time move from the old public folder ---------- */
+
+// Earlier versions stored photos in backend/uploads and served that folder to
+// everyone. This moves the photos that belong to saved messages into private
+// storage and rewrites their addresses. Safe to run on every start.
+async function migrateLegacyUploads() {
+  let legacyFiles;
+
+  try {
+    legacyFiles = await fs.promises.readdir(LEGACY_DIR);
+  } catch {
+    return { moved: 0, missing: 0 };
+  }
+
+  // Temporary photos are meant to disappear anyway.
+  await fs.promises
+    .rm(path.join(LEGACY_DIR, "tmp"), { recursive: true, force: true })
+    .catch(() => {});
+
+  const rows = await pool.query(
+    `SELECT id, room, image_url FROM messages WHERE image_url LIKE '/uploads/%'`,
+  );
+
+  let moved = 0;
+  let missing = 0;
+
+  for (const row of rows.rows) {
+    const name = row.image_url.slice("/uploads/".length);
+    const conversationId = Number(/^conversation_(\d+)$/.exec(row.room)?.[1]);
+
+    if (!isValidImageName(name) || !isValidConversationId(conversationId)) {
+      continue;
+    }
+
+    const source = path.join(LEGACY_DIR, name);
+    const target = imagePath(conversationId, name, false);
+
+    try {
+      await fs.promises.mkdir(path.dirname(target), {
+        recursive: true,
+        mode: 0o700,
+      });
+
+      try {
+        await fs.promises.rename(source, target);
+      } catch (error) {
+        if (error.code !== "EXDEV") throw error;
+
+        await fs.promises.copyFile(source, target);
+        await fs.promises.unlink(source);
+      }
+
+      moved += 1;
+    } catch (error) {
+      if (error.code !== "ENOENT") throw error;
+
+      missing += 1; // the file was already gone
+    }
+
+    await pool.query(`UPDATE messages SET image_url = $2 WHERE id = $1`, [
+      row.id,
+      imageUrl(conversationId, name),
+    ]);
+  }
+
+  const left = legacyFiles.filter((file) => IMAGE_NAME.test(file)).length;
+
+  if (moved || missing || left) {
+    console.log(
+      `Photo storage: moved ${moved} photo(s) to private storage` +
+        (missing ? `, ${missing} were already missing` : "") +
+        (left ? `. ${left} unreferenced file(s) remain in backend/uploads (no longer served)` : ""),
+    );
+  }
+
+  return { moved, missing };
+}
+
+module.exports = {
+  MAX_IMAGE_BYTES,
+  UPLOAD_ROOT,
+  TEMP_ROOT,
+  LEGACY_DIR,
+  isValidConversationId,
+  isValidImageName,
+  mimeTypeFor,
+  detectImageType,
+  imageUrl,
+  parseImageUrl,
+  imagePath,
+  ensureUploadDirs,
+  saveImage,
+  findImage,
+  relocateImage,
+  deleteConversationImages,
+  cleanTempUploads,
+  cleanOrphanUploads,
+  migrateLegacyUploads,
+};
